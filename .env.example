# Supabase configuration for MySnyatyn
# Отримайте ці значення у вашій панелі Supabase: Project Settings -> API

# Публічна URL-адреса проєкту Supabase (доступна на клієнті та сервері)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Публічний анонімний ключ API (безпечний для використання у браузері)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Серверний секретний ключ (використовується ТІЛЬКИ на сервері / API маршрутах)
# НІКОЛИ не передавайте цей ключ на фронтенд і не додавайте у Git!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Опціонально: прямий рядок підключення до бази PostgreSQL (якщо потрібні міграції)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
